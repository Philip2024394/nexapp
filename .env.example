# =============================================================================
# NEX · environment configuration template
# =============================================================================
#
# Target: Phase 1 launch (chat + themes). Commerce and NEX Search are
# gated OFF by default per sealed doctrine at
# `src/lib/nex-native/launch-flags.ts`.
#
# Scope of this template:
#   PART 1 · REQUIRED for Phase 1 to work at all
#   PART 2 · OPERATOR DECISION REQUIRED before Phase 1 can deploy
#   PART 3 · OPTIONAL (sensible defaults exist in code)
#   PART 4 · MUST REMAIN UNSET IN PRODUCTION (legacy / dev-only / admin bypass)
#   PART 5 · NOT CONFIGURED FOR PHASE 1 (Phase 2+ workstreams)
#
# Authority for this template:
#   - Variable inventory: docs/doctrine/nex-env-vars-inventory-2026-10-14.md
#   - Supabase project seal: nexapp CLAUDE.md §8
#   - Launch-flag doctrine: src/lib/nex-native/launch-flags.ts
#   - Global launch report: docs/doctrine/nex-global-launch-readiness-2026-10-14.md
#
# Secret generation guidance:
#   Random 32-byte secret:  openssl rand -base64 32
#   VAPID keypair:          npx web-push generate-vapid-keys
#   Supabase credentials:   Supabase dashboard > Project Settings > API
#
# Never commit real values. Keep real secrets in `.env.local` (gitignored).
# This file (`.env.example`) must contain names and empty values only.
#
# =============================================================================


# =============================================================================
# PART 1 · REQUIRED for Phase 1 chat+themes launch
# =============================================================================
# A Phase 1 deployment will not function without these set correctly.
# =============================================================================


# -----------------------------------------------------------------------------
# 1.1 · Supabase · the canonical NEX project
# -----------------------------------------------------------------------------
# All four variables below MUST point at the same Supabase project.
#
# Canonical NEX project per nexapp CLAUDE.md §8:
#   Project ID : ijvqdvsvwtwxzcqmoqit
#   Owner      : asknexapp@gmail.com
#   Region     : aws-0-eu-west-1 (Ireland)
#   URL        : https://ijvqdvsvwtwxzcqmoqit.supabase.co
#
# Operator action: open the Supabase dashboard for that project and copy
#   - the Project URL (same for both URL vars below)
#   - the `anon` public API key (JWT, role claim "anon")
#   - the `service_role` secret API key (JWT, role claim "service_role")
# Never log, print, or commit the service_role key. Rotate immediately if
# it ever leaves the operator's authorised secret store.

# server-only · admin writes · consumed by src/lib/nex-native/supabase-admin.ts
NEX_SUPABASE_URL=

# server-only · SECRET · consumed by src/lib/nex-native/supabase-admin.ts
NEX_SUPABASE_SERVICE_ROLE_KEY=

# public · SSR + realtime + client · consumed by src/middleware.ts and ~15
# nex-native surfaces · must equal NEX_SUPABASE_URL
NEXT_PUBLIC_NEX_SUPABASE_URL=

# public · SSR + realtime · JWT with role claim "anon"
NEXT_PUBLIC_NEX_SUPABASE_ANON_KEY=


# -----------------------------------------------------------------------------
# 1.2 · Session + encryption secrets
# -----------------------------------------------------------------------------
# Random 32+ byte strings. Generate with `openssl rand -base64 32`.
# NEVER re-use across environments. Rotate on exposure.

# server-only · signs session cookies
NEX_SESSION_SECRET=

# server-only · symmetric encryption key for application-layer encrypted fields
ENC_KEY=


# -----------------------------------------------------------------------------
# 1.3 · Cron authentication
# -----------------------------------------------------------------------------
# Random 32+ byte string. Vercel sends this in a header to protect the
# scheduled cron endpoint at `/api/nex-native/harvest/tick`. See vercel.json.

# server-only · required if any cron is enabled in vercel.json
CRON_SECRET=


# -----------------------------------------------------------------------------
# 1.4 · Push notifications (Web Push / VAPID)
# -----------------------------------------------------------------------------
# Generate the keypair ONCE with:  npx web-push generate-vapid-keys
# Use the SAME keypair in every environment that shares a push subscriber
# database. If you rotate, every subscribed device loses push until it
# re-subscribes.
#
# Note on naming: the `XRATED_` prefix is legacy monorepo residue and will
# be renamed in a future hygiene PR. For now, use the exact names below.

# public · base64url · ~87 bytes · consumed by client push subscription
NEXT_PUBLIC_XRATED_VAPID_PUBLIC_KEY=

# server-only · base64url · ~43 bytes · SECRET
XRATED_VAPID_PRIVATE_KEY=

# server-only · an RFC 8292 "sub" value · typically a mailto URI
# (e.g. mailto:ops@example.org) or an HTTPS URL that identifies the sender
XRATED_VAPID_SUBJECT=


# =============================================================================
# PART 2 · OPERATOR DECISION REQUIRED
# =============================================================================
# These variables cannot be set correctly until the operator makes a
# documented policy decision. Each decision is listed in the B1 inventory
# report §Section G.
# =============================================================================


# -----------------------------------------------------------------------------
# 2.1 · Postgres direct connection (DECISION D1 · see inventory §G)
# -----------------------------------------------------------------------------
# Current state per nexapp CLAUDE.md §8 lines 73-77: NEX_POSTGRES_URL points
# at localhost:5433 for local development. The directory canonical read path
# uses this env var. Three options for production:
#
#   (a) Apply the directory canonical migrations to the canonical Supabase
#       project and set this to the Supabase pooler URL
#       (aws-0-eu-west-1.pooler.supabase.com)
#   (b) Rewrite the `@/lib/nex/db` layer to use the Supabase REST client
#       (removes need for a direct Postgres connection)
#   (c) Disable the directory read path for Phase 1 (not yet designed)
#
# This template cannot pick for the operator. Leave the value unset for
# a dev build. Flag the decision and record it in a sealed note before
# a production deploy of any directory-touching surface.
#
# server-only · postgres:// URL · do NOT set to localhost in production

# NEX_POSTGRES_URL=
# NEX_CANONICAL_PG_URL=
# DATABASE_URL=


# -----------------------------------------------------------------------------
# 2.2 · Canonical public app URL (DECISION D2 · see inventory §G)
# -----------------------------------------------------------------------------
# The codebase reads six overlapping variables for the same conceptual
# value ("where is this app deployed"). Until the cleanup PR consolidates
# them, operator must either:
#
#   (a) Set NEXT_PUBLIC_APP_BASE_URL only and accept the risk that any
#       code path reading one of the alternate names will fall back to
#       undefined (acceptable for Phase 1 if no such path is reached), OR
#   (b) Set all six to the same value for safety
#
# Recommended canonical: NEXT_PUBLIC_APP_BASE_URL
# All vars must point at the deployed origin, no trailing slash, HTTPS.

# public · recommended canonical name for the deployed URL
NEXT_PUBLIC_APP_BASE_URL=

# public · alternate aliases found in source · set to the same value for
# safety during Phase 1, remove once a cleanup PR consolidates them
# NEXT_PUBLIC_BASE_URL=
# NEXT_PUBLIC_NEX_BASE_URL=
# NEXT_PUBLIC_SITE_URL=

# server-only mirrors (unusual naming "NEX_PUBLIC_*" is distinct from
# "NEXT_PUBLIC_*") · set to the same value if your code reads them
# NEX_PUBLIC_APP_BASE_URL=
# NEX_PUBLIC_BASE_URL=

# ------ Per-region site URL (I9 · 2026-11-16) ------
# src/lib/nex-native/seo/site-url-resolver.ts reads two region-
# specific envs for metadataBase, canonicals, sitemap, and JSON-LD.
# Prod builds FAIL when the active country's env is unset or
# resolves to localhost (safety rule · see resolver lines 17-21).
#
# Required in prod per sealed Scope Reduction 2026-11-06 ship-list
# (core four markets · USD + GBP + IDR + EUR):
#   · NEX_PUBLIC_SITE_URL_IE · REQUIRED when NEX_APP_IDENTITY=ireland
#   · NEX_PUBLIC_SITE_URL_WW · REQUIRED when NEX_APP_IDENTITY=worldwide
#                              OR NEX_APP_IDENTITY=indonesia
#                              (Indonesia currently falls back to _WW;
#                              a dedicated `_ID` env would need a
#                              site-url-resolver.ts change first)
#
# No dedicated _UK, _US, _ID envs are read by src/ today. See
# docs/doctrine/launch-infra-I9-2026-11-16.md.

# NEX_PUBLIC_SITE_URL_IE=
# NEX_PUBLIC_SITE_URL_WW=

# Country selector · per-Vercel-env value · picks IE/WW/ID branch
# NEX_APP_IDENTITY=
# NEX_APP_COUNTRY=


# -----------------------------------------------------------------------------
# 2.3 · WebAuthn relying-party identity (DECISION D3 · see inventory §G)
# -----------------------------------------------------------------------------
# WebAuthn ties credentials to a specific origin. In production you must
# set these explicitly — the fallback at src/lib/nex-native/webauthn-config.ts
# derives these from the request Host header, which is a security risk
# in production (header injection could redirect credentials).
#
# RP_ID is the DNS hostname only (no scheme, no port, no path).
# ORIGIN is the full HTTPS origin (scheme + host, no path, no trailing slash).
# RP_ID must be a registrable domain suffix of ORIGIN.
#
# NOTE · the WebAuthn API routes at src/app/api/nex-native/auth/webauthn/*
# have known TypeScript errors from a @simplewebauthn/server v11 API change
# (B4 in the global launch report). WebAuthn sign-in will not work until
# that is repaired independently.
#
# Per-domain guidance (I11 · 2026-11-16 · see
# docs/doctrine/launch-infra-I11-2026-11-16.md):
#   · prod Ireland  · RP_ID = chosen apex (e.g. "nex.app")
#                   · ORIGIN = "https://" + apex
#   · prod Worldwide · same values when both regions share the apex
#   · preview       · use a dedicated preview subdomain OR disable WebAuthn
#                     (credentials created on *.vercel.app will not be
#                     usable on the apex and vice versa).
#   · local dev     · RP_ID = "localhost" · ORIGIN = "http://localhost:3008"
#                     (the WebAuthn spec permits HTTP only for localhost)
#
# Changing the prod apex later ORPHANS every credential already
# registered on the old apex. This is a WebAuthn protocol property.

# server-only · DNS hostname matching the deployed origin's host
NEX_WEBAUTHN_RP_ID=

# server-only · full HTTPS origin
NEX_WEBAUTHN_ORIGIN=

# server-only · human-readable name shown in the WebAuthn consent prompt
# · defaults to "NEX" if unset · empty value here means "use the default"
NEX_WEBAUTHN_RP_NAME=


# -----------------------------------------------------------------------------
# 2.4 · Transactional email provider (DECISION D4 · see inventory §G)
# -----------------------------------------------------------------------------
# The repository supports several email delivery backends in src/lib/nex/
# delivery and src/lib/nex/listing-chat. The operator must pick ONE
# provider. Each one has its own env-var group. Only set the group for
# the chosen provider. Un-chosen groups must remain fully unset.
#
# NOTE · all four of the SendGrid / Mailgun / Postmark / SMTP paths are in
# the legacy src/lib/nex/* layer. Verify at implementation time that at
# least one path is reachable from the sign-up flow before relying on
# transactional email in production.
#
# For Phase 1 chat+themes launch to need transactional email at all, the
# sign-up flow must send a verification message. If sign-up for Phase 1
# does NOT send email, this entire section can be skipped.

# NEX_EMAIL_PROVIDER=     # One of: resend | mailgun | postmark | sendgrid | ses | smtp
# NEX_DELIVERY_PROVIDER=  # Same semantics in some code paths

# ---- Option A · Resend (if NEX_EMAIL_PROVIDER=resend) ----
# RESEND_API_KEY=
# NEX_ALERTS_EMAIL_FROM=
# NEX_ALERTS_EMAIL_TO=

# ---- Option B · Mailgun (if NEX_EMAIL_PROVIDER=mailgun) ----
# NEX_DELIVERY_MAILGUN_API_KEY=
# NEX_DELIVERY_MAILGUN_DOMAIN=
# NEX_DELIVERY_MAILGUN_HOST=
# MAILGUN_API_KEY=   # alternate legacy name · set only if your code path reads this

# ---- Option C · Postmark (if NEX_EMAIL_PROVIDER=postmark) ----
# NEX_DELIVERY_POSTMARK_SERVER_TOKEN=
# NEX_DELIVERY_POSTMARK_MESSAGE_STREAM=
# NEX_DELIVERY_POSTMARK_WEBHOOK_USER=
# NEX_DELIVERY_POSTMARK_WEBHOOK_PASS=
# POSTMARK_API_TOKEN=   # alternate legacy name

# ---- Option D · SendGrid (if NEX_EMAIL_PROVIDER=sendgrid) ----
# NEX_DELIVERY_SENDGRID_API_KEY=
# NEX_DELIVERY_SENDGRID_WEBHOOK_PUBLIC_KEY=
# SENDGRID_API_KEY=   # alternate legacy name

# ---- Option E · AWS SES (if NEX_EMAIL_PROVIDER=ses) ----
# NEX_DELIVERY_SES_ACCESS_KEY_ID=
# NEX_DELIVERY_SES_SECRET_ACCESS_KEY=
# NEX_DELIVERY_SES_SESSION_TOKEN=
# NEX_DELIVERY_SES_REGION=
# NEX_DELIVERY_SES_CONFIGURATION_SET=

# ---- Option F · SMTP (if NEX_EMAIL_PROVIDER=smtp) ----
# NEX_SMTP_HOST=
# NEX_SMTP_PORT=
# NEX_SMTP_USER=
# NEX_SMTP_PASS=
# NEX_SMTP_FROM=
# NEX_SMTP_SECURE=
# NEX_SMTP_VERIFY_EHLO=
# NEX_SMTP_VERIFY_FROM=


# -----------------------------------------------------------------------------
# 2.5 · SafeChat launch scope (DECISION D5 · see inventory §G)
# -----------------------------------------------------------------------------
# Family Safety SafeChat is a sealed feature set. Its user-facing surface
# must stay OFF unless the Family Safety release gate authorises it for
# Phase 1 launch. Logging can be on in staging to collect baseline data.

# server-only · gates SafeChat Phase 1 observability log
# NEX_SAFECHAT_PHASE_1_LOGGING_ENABLED=

# server-only · gates user-facing SafeChat UI · defaults to false if unset
# · PHASE 1 DEFAULT: false unless the SafeChat Phase 1 gate is authorised
# NEX_SAFECHAT_USER_FACING_ENABLED=


# -----------------------------------------------------------------------------
# 2.6 · Emergency help launch scope (DECISION D6 · see inventory §G)
# -----------------------------------------------------------------------------
# Emergency help surfaces (/emergency-help) involve real notifications
# (optionally email). Phase 1 default is OFF unless explicitly authorised.
# Live mode and real email send must be reviewed with the Family Safety
# gate before enabling.

# NEX_EMERGENCY_HELP_ENABLED=
# NEX_EMERGENCY_LIVE_MODE=
# NEX_EMERGENCY_EMAIL_REAL_SEND=
# NEX_EMERGENCY_DEFAULT_RADIUS_KM=
# NEX_EMERGENCY_WIDER_COMMUNITY_ENABLED=


# =============================================================================
