+   );
+ }
+
+ function StoragePlanCard({
+   plan,
+   region,
+   viewerKind,
+ }: {
+   plan: StoragePlan;
+   region: SupportedRegion;
+   viewerKind: ViewerState["kind"];
+ }): React.JSX.Element {
+   const price = bundledPrice(
+     region,
+     plan.storagePackIndex,
+     plan.bandwidthPackIndex,
+   );
+   const priceLabel = price ? `${price.label} / month` : "Price coming soon";
+   // Owner directive 2026-11-09 (round 33b) · Upgrade button is NOW
+   // wired to /api/nex-native/billing/checkout/pack via the client
+   // component · opens Stripe hosted checkout · redirects back to
+   // /settings/storage?pack_purchase=success on completion. Button
+   // stays disabled with explanatory tooltip when viewer is signed
+   // out or has no shop (fail-closed · the client component enforces
+   // this).
+   const packKey = STORAGE_PACKS[plan.storagePackIndex].size as
+     | "pack_5gb"
+     | "pack_10gb"
+     | "pack_25gb";
+   // Pack bars are empty until purchased · when wired, this card's
+   // bar will show how much of the bought pack has been consumed.
+   const packTotalBytes = STORAGE_PACKS[plan.storagePackIndex].bytes;
+   return (
+     <div
+       style={{
+         display: "flex",
+         flexDirection: "column",
+         padding: "12px 14px",
+         background: "rgba(2,9,20,0.5)",
+         border: `1px solid ${BORDER}`,
+         borderRadius: 12,
+         gap: 8,
+       }}
+     >
+       <div
+         style={{
+           display: "flex",
+           alignItems: "center",
+           justifyContent: "space-between",
+           gap: 12,
+         }}
+       >
+         <div style={{ display: "flex", flexDirection: "column", gap: 2 }}>
+           <span style={{ fontSize: 13, fontWeight: 900, color: CREAM }}>
+             {plan.label}
+           </span>
+           <span style={{ fontSize: 11, color: GOLD, fontWeight: 800 }}>
+             {priceLabel}
+           </span>
+         </div>
+         <PackUpgradeButton
+           packKey={packKey}
+           viewerKind={viewerKind}
+           inkMuted={INK_MUTED}
+           border={BORDER}
+           gold={GOLD}
+           cream={CREAM}
+           red="#A60000"
+         />
+       </div>
+       <StorageBar
+         pct={0}
+         label={`0 / ${formatBytes(packTotalBytes, "GB")}`}
+       />
+     </div>
+   );
+ }
+
+ function StorageBar({
+   pct,
+   label,
+ }: {
+   pct: number;
+   label: string;
+ }): React.JSX.Element {
+   const safePct = Math.max(0, Math.min(100, pct));
+   return (
+     <div>
+       <div
+         style={{
+           position: "relative",
+           height: 6,
+           borderRadius: 999,
+           background: "rgba(2,9,20,0.75)",
+           border: `1px solid ${BORDER}`,
+           overflow: "hidden",
+         }}
+       >
+         <div
+           style={{
+             width: `${safePct}%`,
+             height: "100%",
+             background: safePct >= 90 ? "#E67A3C" : GOLD,
+             transition: "width 160ms ease-out",
+           }}
+         />
+       </div>
+       <div
+         style={{
+           fontSize: 10,
+           color: INK_MUTED,
+           marginTop: 4,
+           textAlign: "right",
+         }}
+       >
+         {label}
+       </div>
+     </div>
+   );
+ }
+
+ function formatBytes(bytes: number, unitLabel: string): string {
+   if (!Number.isFinite(bytes) || bytes < 0) return `0 ${unitLabel}`;
+   const GB = 1_000_000_000;
+   const MB = 1_000_000;
+   if (bytes >= GB) {
+     const gb = bytes / GB;
+     return `${gb >= 10 ? gb.toFixed(0) : gb.toFixed(1)} ${unitLabel}`;
+   }
+   const mb = bytes / MB;
+   return `${mb >= 10 ? mb.toFixed(0) : mb.toFixed(1)} MB`;
+ }
