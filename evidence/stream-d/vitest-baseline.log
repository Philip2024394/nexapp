              padding: \"2px 10px\",
              borderRadius: 999,
              border: `1px solid ${PALETTE.borderSoft}`,
              background:
                distanceChipKind === \"known\"
                  ? PALETTE.surfaceHi
                  : \"transparent\",
              whiteSpace: \"nowrap\",
            }}
          >
            {distanceChipLabel}
          </span>
        </div>
        {place !== null ? (
          <p
            data-nex-directory-card-place
            style={{
              margin: 0,
              color: PALETTE.textMuted,
              fontSize: 14,
              lineHeight: 1.4,
            }}
          >
            {place}
          </p>
        ) : null}
        {streetSnippet !== null ? (
          <p
            data-nex-directory-card-street
            style={{
              margin: 0,
              color: PALETTE.textSoft,
              fontSize: 14,
              lineHeight: 1.4,
              overflow: \"hidden\",
              textOverflow: \"ellipsis\",
              whiteSpace: \"nowrap\",
            }}
          >
            {streetSnippet}
          </p>
        ) : null}
        {categories.length > 0 ? (
          <ul
            aria-label=\"Categories\"
            data-nex-directory-card-categories
            style={{
              margin: \"2px 0 0 0\",
              padding: 0,
              listStyle: \"none\",
              display: \"flex\",
              gap: 6,
              flexWrap: \"wrap\",
            }}
          >
            {categories.slice(0, 3).map((c) => (
              <li
                key={c}
                style={{
                  fontSize: 13,
                  fontWeight: 500,
                  padding: \"3px 10px\",
                  background: PALETTE.surfaceHi,
                  color: PALETTE.textDim,
                  borderRadius: 999,
                }}
              >
                {c}
              </li>
            ))}
          </ul>
        ) : null}
        {keywords.length > 0 ? (
          <p
            data-nex-directory-card-keywords
            style={{
              margin: 0,
