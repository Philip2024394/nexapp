function resolveCountryName(iso: string): string {
  if (!/^[A-Z]{2}$/.test(iso)) return iso;
  for (const entry of ISO_COUNTRIES) {
    if (entry.isoAlpha2 === iso) return entry.name;
  }
  return iso;
}



