// chrome. The sealed primitive stays untouched so production peer-
// chat (_call-launcher.tsx) + /voice-preview keep their existing
// palette.
//
// Buttons on the bar (owner directive 2026-11-08 round 18):
//   · Mute · emerald · local toggle · when off, the tile-level
//     mic-off red-strike indicator fires too (coordinated via
//     parent's participant state in a future wire).
//   · Camera · emerald · local toggle.
//   · Flip camera · emerald · placeholder (wired=false · requires
//     the GroupCallEngine mount).
//   · More · emerald · placeholder (wired=false).
//   · End call · DARK RED · owner-exact \"end call dark red\".
//     Routes back to /nex-native/calls.

import * as React from \"react\";
import { useRouter } from \"next/navigation\";

const NEX = {
  emerald: \"#16D66B\",
  emeraldSoft: \"rgba(22,214,107,0.14)\",
  emeraldBorder: \"rgba(22,214,107,0.45)\",
  endRed: \"#8B1A24\",
  endRedBright: \"#A6212F\",
  textDim: \"#B5C3D6\",
  textMute: \"#7D9BC0\",
  ink: \"#F2F5F8\",
};

export function CallControlBarShell(): React.JSX.Element {
  const router = useRouter();
  const [muted, setMuted] = React.useState(false);
  const [cameraOff, setCameraOff] = React.useState(true);

  return (
    <div
      role=\"toolbar\"
      aria-label=\"Call controls\"
      data-nex-call-control-bar
      style={{
        display: \"flex\",
        alignItems: \"center\",
        justifyContent: \"center\",
        gap: 12,
        padding: \"14px 16px 20px\",
        background:
          \"linear-gradient(0deg, rgba(4,14,9,0.92) 0%, rgba(4,14,9,0.45) 100%)\",
        flexShrink: 0,
      }}
    >
      <ControlButton
        label={muted ? \"Unmute\" : \"Mute\"}
        active={!muted}
        onClick={() => setMuted((v) => !v)}
        data-wired=\"local\"
      >
        {muted ? <MicOffGlyph /> : <MicGlyph />}
      </ControlButton>

      <ControlButton
        label={cameraOff ? \"Turn camera on\" : \"Turn camera off\"}
        active={!cameraOff}
        onClick={() => setCameraOff((v) => !v)}
        data-wired=\"local\"
      >
        {cameraOff ? <CameraOffGlyph /> : <CameraGlyph />}
      </ControlButton>

      <ControlButton
        label=\"Flip camera · coming later\"
        active={false}
        disabled
        onClick={() => undefined}
        data-wired=\"false\"
      >
        <FlipGlyph />
      </ControlButton>

      <ControlButton
        label=\"More · coming later\"
        active={false}
        disabled
        onClick={() => undefined}
        data-wired=\"false\"
      >
        <MoreGlyph />
      </ControlButton>

      {/* Owner-reported 2026-11-08 round 21 · /nex-native/calls is
          404 on this branch (the sealed Calls hub route does not
          exist yet). End-call falls back to /nex-native/contacts
          · that is where a user would go to invite someone to a
          new call anyway. router.back() would send the user to the
          previous page which might be a chat; the explicit push
          to /contacts matches the Call Center intent.*/}
      <EndCallButton onEnd={() => router.push(\"/nex-native/contacts\")} />
    </div>
  );
}

// ─── Buttons ──────────────────────────────────────────────────────

interface ControlButtonProps {
  readonly label: string;
  readonly active: boolean;
  readonly disabled?: boolean;
  readonly onClick: () => void;
  readonly children: React.ReactNode;
  readonly \"data-wired\"?: \"local\" | \"false\" | \"engine\";
}

function ControlButton({
  label,
  active,
  disabled,
  onClick,
  children,
  \"data-wired\": dataWired,
}: ControlButtonProps): React.JSX.Element {
  return (
    <button
      type=\"button\"
      aria-label={label}
      title={label}
      disabled={disabled}
      onClick={onClick}
      data-nex-call-control
      data-nex-call-control-wired={dataWired}
      data-nex-call-control-active={active ? \"on\" : \"off\"}
      style={{
        width: 48,
        height: 48,
        borderRadius: 999,
        border: `1px solid ${NEX.emeraldBorder}`,
        background: active ? NEX.emeraldSoft : \"rgba(2,9,20,0.55)\",
        color: active ? NEX.emerald : NEX.textDim,
        display: \"inline-flex\",
        alignItems: \"center\",
        justifyContent: \"center\",
        cursor: disabled ? \"not-allowed\" : \"pointer\",
        opacity: disabled ? 0.55 : 1,
        transition:
          \"background 160ms ease, color 160ms ease, transform 120ms ease\",
        fontFamily: \"inherit\",
        WebkitTapHighlightColor: \"transparent\",
      }}
    >
      {children}
    </button>
  );
}

function EndCallButton({
  onEnd,
}: {
  readonly onEnd: () => void;
}): React.JSX.Element {
  return (
    <button
      type=\"button\"
      aria-label=\"End call\"
      title=\"End call\"
      onClick={onEnd}
      data-nex-call-end
      data-nex-call-end-wired=\"local\"
      style={{
        minWidth: 64,
        height: 48,
        padding: \"0 18px\",
        borderRadius: 999,
        border: `1px solid ${NEX.endRed}`,
        background:
          `linear-gradient(180deg, ${NEX.endRedBright} 0%, ${NEX.endRed} 100%)`,
        color: NEX.ink,
        display: \"inline-flex\",
        alignItems: \"center\",
        justifyContent: \"center\",
        gap: 8,
        cursor: \"pointer\",
        boxShadow: \"0 2px 14px rgba(139,26,36,0.35)\",
        fontFamily: \"inherit\",
        fontSize: 12,
        fontWeight: 800,
        letterSpacing: \"0.08em\",
        textTransform: \"uppercase\",
        WebkitTapHighlightColor: \"transparent\",
      }}
    >
      <EndCallGlyph />
      <span>End</span>
    </button>
  );
}

