    {
      href: \"/nex-native/emergency-help\",
      icon: \"🚨\",
      titleKey: \"settings.hero.emergencyHelp\",
      tone: \"danger\",
    },
    {
      href: \"/nex-native/community\",
      icon: \"🏘\",
      titleKey: \"settings.hero.community\",
      tone: \"orange\",
