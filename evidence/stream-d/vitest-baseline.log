        {areaIntel !== null && areaIntel !== undefined ? (
          <p
            data-nex-directory-card-area-known-for
            data-nex-directory-card-area-id={areaIntel.areaId}
            style={{
              margin: \"2px 0 0 0\",
              color: PALETTE.textDim,
