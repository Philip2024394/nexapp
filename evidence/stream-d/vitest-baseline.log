            <li
              key={c}
              data-nex-directory-detail-category-chip={c}
              style={{
                fontSize: 12.5,
                fontWeight: 500,
                padding: \"4px 10px\",
                background: NEX.surfaceHi,
                color: NEX.textDim,
                borderRadius: 999,
              }}
            >
              {c}
            </li>
          ))}
        </ul>
      ) : null}
    </SectionBlock>
  );
}


