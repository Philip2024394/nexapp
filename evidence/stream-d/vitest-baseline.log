        >
          {known.map((meta) => (
            <CategoryCard key={meta.slug} meta={meta} />
          ))}
        </div>
      ) : null}
      {unknown.length > 0 ? (
        <ul
          aria-label=\"Other categories\"
          data-nex-directory-detail-category-chips
          style={{
