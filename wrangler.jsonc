{
  // Cloudflare Workers config for nexapp · OpenNext adapter target
  // -------------------------------------------------------------------
  //
  // Top-level config = production Worker (name: nexapp).
  // env.preview = sandbox preview Worker (name: nexapp-preview).
  //
  // Minimal bindings for first deploy:
  //   · ASSETS (Workers static-asset binding, free, required)
  //   · nodejs_compat + global_fetch_strictly_public (free flags)
  //
  // Deferred bindings — add only when a surface proves it needs them:
  //   · r2_buckets (NEXT_INC_CACHE_R2_BUCKET) · needs R2 enabled on
  //     account; dummyCache is adequate for first deploy
  //   · services (WORKER_SELF_REFERENCE) · chicken-and-egg on first
  //     deploy; add only once self-fetch is actually required
  //   · images (Workers Images) · paid feature
  //
  // Deploys are gated by CLAUDE.md §4/§5 and the Cloudflare deploy
  // workflow is manual-only (workflow_dispatch).
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "cloudflare/worker.mjs",
  "name": "nexapp",
  "compatibility_date": "2026-11-21",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "NEXT_PUBLIC_APP_ENV": "production",
    "NEXT_PUBLIC_SITE_URL": "https://nexcorner.com",
    "NEX_SITE_URL": "https://nexcorner.com",
    "NEX_APP_IDENTITY": "ireland",
    "NEX_PUBLIC_SITE_URL_IE": "https://nexcorner.com",
    "NEX_PUBLIC_SITE_URL_WW": "https://nexcorner.com"
  },
  // Crons declared here stay DORMANT (commented) until Vercel crons are
  // confirmed off. Enabling this list is the second deploy per the
  // staged cutover plan.
  // "triggers": {
  //   "crons": [
  //     "0 * * * *",        // harvest/tick · hourly
  //     "*/15 * * * *",     // billing/cron/reconcile · 15 min
  //     "*/10 * * * *"      // cron/security-audit-reconcile · 10 min
  //   ]
  // },
  "env": {
    "preview": {
      "name": "nexapp-preview",
      "compatibility_date": "2026-11-21",
      "compatibility_flags": [
        "nodejs_compat",
        "global_fetch_strictly_public"
      ],
      "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
      },
      "vars": {
        "NEXT_PUBLIC_APP_ENV": "preview",
        "NEXT_PUBLIC_SITE_URL": "",
        "NEX_SITE_URL": ""
      }
    }
  }
}
