{
  // Cloudflare Workers config for nexapp · OpenNext adapter target
  // -------------------------------------------------------------------
  //
  // Top-level config = production Worker (name: nexapp).
  // env.preview = sandbox preview Worker (name: nexapp-preview).
  //
  // Minimal bindings for first deploy:
  //   · ASSETS (Workers static-asset binding, free, required)
  //   · nodejs_compat + global_fetch_strictly_public (free flags)
  //
  // Deferred bindings — add only when a surface proves it needs them:
  //   · r2_buckets (NEXT_INC_CACHE_R2_BUCKET) · needs R2 enabled on
  //     account; dummyCache is adequate for first deploy
  //   · services (WORKER_SELF_REFERENCE) · chicken-and-egg on first
  //     deploy; add only once self-fetch is actually required
  //   · images (Workers Images) · paid feature
  //
  // Deploys are gated by CLAUDE.md §4/§5 and the Cloudflare deploy
  // workflow is manual-only (workflow_dispatch).
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "cloudflare/worker.mjs",
  "name": "nexapp",
  "compatibility_date": "2026-11-21",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "NEXT_PUBLIC_APP_ENV": "production",
    "NEXT_PUBLIC_SITE_URL": "https://nexcorner.com",
    "NEX_SITE_URL": "https://nexcorner.com",
    "NEX_APP_IDENTITY": "ireland",
    "NEX_PUBLIC_SITE_URL_IE": "https://nexcorner.com",
    "NEX_PUBLIC_SITE_URL_WW": "https://nexcorner.com"
  },
  // Owner directive 2026-11-28 · XRATEDBELTS.COM vanity domain.
  // Routes bind the production Worker to the customer-facing hostnames
  // for the X-Rated Tool Belts shop. These take effect ONLY on the
  // NEXT production deploy and require:
  //   1. DNS for xratedbelts.com already pointing at Cloudflare
  //      (either via NS change to Cloudflare, or via Cloudflare-hosted
  //       zone with the apex + www proxied).
  //   2. The `xratedbelts.com` zone added to this Cloudflare account.
  //   3. Owner-authorised `workflow_dispatch` of cloudflare-deploy.yml
  //      targeting production.
  // Deploy is intentionally NOT automatic; the push that lands these
  // routes does not trigger a production deploy (release-audit branch
  // deploys preview only · production is manual-dispatch).
  // Using `custom_domain: true` so Cloudflare automatically provisions
  // the A/AAAA records that point the hostnames at the Worker and
  // issues the Universal SSL certificate. Prerequisite: the
  // `xratedbelts.com` zone must exist in this Cloudflare account
  // before `wrangler deploy` is run against production.
  "routes": [
    {
      "pattern": "xratedbelts.com",
      "custom_domain": true
    },
    {
      "pattern": "www.xratedbelts.com",
      "custom_domain": true
    }
  ],
  // Crons declared here stay DORMANT (commented) until Vercel crons are
  // confirmed off. Enabling this list is the second deploy per the
  // staged cutover plan.
  // "triggers": {
  //   "crons": [
  //     "0 * * * *",        // harvest/tick · hourly
  //     "*/15 * * * *",     // billing/cron/reconcile · 15 min
  //     "*/10 * * * *"      // cron/security-audit-reconcile · 10 min
  //   ]
  // },
  "env": {
    "preview": {
      "name": "nexapp-preview",
      "compatibility_date": "2026-11-21",
      "compatibility_flags": [
        "nodejs_compat",
        "global_fetch_strictly_public"
      ],
      "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
      },
      "vars": {
        "NEXT_PUBLIC_APP_ENV": "preview",
        "NEXT_PUBLIC_SITE_URL": "",
        "NEX_SITE_URL": ""
      }
    }
  }
}
