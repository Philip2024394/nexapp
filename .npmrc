# 2026-10-10 · legacy-peer-deps required because
# @imgly/background-removal@1.7.0 pins peer onnxruntime-web@1.21.0
# but the project uses onnxruntime-web@^1.27.0 elsewhere. The two
# are compatible in practice but strict peer-dep resolution refuses
# the install. This flag makes npm (local AND Vercel) accept the
# resolution. Remove when the imgly peer-range widens.
legacy-peer-deps=true
