# .editorconfig · NEX
# https://editorconfig.org/
#
# Consistent file formatting across editors. No code behaviour impact.

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{sql,sql.rollback}]
indent_size = 2

[Makefile]
indent_style = tab
